<link href="/Portals/_default/leaflet/leaflet.css" rel="stylesheet" />
<link rel="stylesheet" href="/Portals/_default/leaflet/Control.FullScreen.css" />
<style>
    .all-map-content {
        position: relative;
        width: 100%;
    }

    .fix-form-map {
        width: 100%;
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 0px;
        z-index: 999;
    }

    .form-map {
        width: 650px;
        background: #fff;
        margin: 0 auto;
        border: 1px solid #eee;
        padding: 10px;
    }

    .form-select {
        width: 200px;
    }

    .form-label {
        position: relative;
        top: 6px;
        font-weight: bold;
    }

    .vietNamToiYeu {
        line-height: 12px;
        position: absolute;
        font-size: 16px;
        padding: 5px 2px;
        background: #fff;
        border-radius: 5px;
        color: #bf1515;
        z-index: 9999;
        font-size: 11px;
        top: -2px;
        left: -2px;
        width: 100px;
        text-align: center;
        font-size: 12px;
        font-weight: bold;
    }

    .icon-vietnamToiYeu {
        width: 20px;
        height: 20px;
    }

    .coVietNam {
        width: 40px;
    }

    .vietNamToiYeu:before, .vietNamToiYeu:after {
        border: none !important;
        display: none;
    }

    .info-box .icon i {
        font-size: 31px;
    }
</style>

